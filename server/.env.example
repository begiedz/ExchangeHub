# Copy to server/.env (git-ignored) and fill in your own values. Never commit .env.

# Password of the local PostgreSQL user "exchangehub".
# Changing it later requires recreating the database volume: docker compose down -v
POSTGRES_PASSWORD=change-me

# HMAC key that signs JWTs, at least 32 characters. The API refuses to start with the placeholder.
# Generate one:   openssl rand -base64 48
#      PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SIGNING_KEY=change-me

# Optional: host ports (defaults shown).
# DB_PORT=5433
# API_PORT=8080
