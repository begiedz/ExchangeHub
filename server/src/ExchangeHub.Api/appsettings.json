{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Jwt": {
      "Issuer": "ExchangeHub",
      "Audience": "ExchangeHub.Mobile",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "LoginProtection": {
      "MaxFailedAttempts": 5,
      "LockoutDuration": "00:15:00"
    }
  }
}
